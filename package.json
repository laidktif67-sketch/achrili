{
  "name": "achrili-platform",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @achrili/web dev",
    "dev:mobile": "pnpm --filter @achrili/mobile start",
    "build": "turbo build",
    "build:web": "pnpm --filter @achrili/web build",
    "typecheck": "turbo typecheck",
    "legacy:dev": "vite",
    "legacy:build": "vite build",
    "test:legacy": "node --test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.12"
  }
}
